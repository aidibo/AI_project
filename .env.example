# 复制为 .env 并按实际环境修改
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=demo
DB_PASSWORD=demo123
DB_NAME=demo_db
DB_CHARSET=utf8mb4

# ---- 华为云 OBS 配置 ----
# 访问密钥（AK/SK），在华为云控制台「我的凭证 - 访问密钥」中获取
OBS_ACCESS_KEY_ID=your_access_key_id
OBS_SECRET_ACCESS_KEY=your_secret_access_key
# 终端节点，例如 obs.cn-north-4.myhuaweicloud.com
OBS_SERVER=obs.cn-north-4.myhuaweicloud.com
OBS_REGION=cn-north-4
# 默认桶名
OBS_BUCKET=your_bucket
# 使用临时凭证（IAM 委托/STS）时填写，否则留空
OBS_SECURITY_TOKEN=
# 签名算法：华为云 OBS 用 obs，兼容 S3 的服务用 v4
OBS_SIGNATURE=obs
# 是否使用 HTTPS
OBS_IS_SECURE=true
# 是否使用 path-style 寻址（自建 S3 兼容服务通常需要 true）
OBS_PATH_STYLE=false
# 是否校验服务端 SSL 证书
OBS_SSL_VERIFY=true
OBS_TIMEOUT=60
OBS_MAX_RETRY_COUNT=3
# 自定义端口，留空使用默认端口
OBS_PORT=
